rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Diagnostic Connection Test ─────────────────────────
    match /testConnection/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Users ─────────────────────────────────────────────
    // Users can read any public profile.
    // Only the owner can create their profile or delete it.
    // Owner can update fields (cannot escalate role/privilege).
    // Non-owners can ONLY update follower count when following/unfollowing.
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isVerified'])
      ) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
      );
      allow delete: if isOwner(uid);
    }

    // ── Usernames (lookup table) ───────────────────────────
    // Anyone can read to check availability.
    // Only authenticated user can reserve a username under their own UID.
    // Only owner of the username can delete or reassign it.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── Posts ─────────────────────────────────────────────
    // Anyone can read posts.
    // Only authenticated user can create posts with authorId == request.auth.uid.
    // Owner can edit caption/media or delete.
    // Non-authors can only update likes_count and comments_count (via like/comment actions).
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count', 'comments_count', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Post comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // ── Reels / Klyps ──────────────────────────────────────
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count', 'comments_count', 'viewsCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // ── Likes ─────────────────────────────────────────────
    // Likes are documented with ID: ${targetId}_${userId}
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── Saved Posts / Bookmarks ───────────────────────────
    // Private to the bookmarking user
    match /savedPosts/{saveId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── Stories & Story Features ───────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    match /storyTags/{tagId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /storyReplies/{replyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    match /storyHighlights/{highlightId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /storyAnalytics/{storyId} {
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow write: if isAuthenticated();
    }

    match /storyViews/{viewId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Events ────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // ── Following & Followers ──────────────────────────────
    match /following/{userId}/userFollowing/{targetId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /followers/{userId}/userFollowers/{targetId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == targetId;
      allow delete: if isAuthenticated() && request.auth.uid == targetId;
    }

    match /follows/{followId} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Notifications ─────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUid == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.targetUid == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
    }

    // ── Helper for Block Checks ─────────────────────────────
    function isBlockedBy(authorUid, targetUid) {
      return exists(/databases/$(database)/documents/blocked/$(authorUid)/blockedUsers/$(targetUid));
    }

    function isBlockedEitherWay(uid1, uid2) {
      return isBlockedBy(uid1, uid2) || isBlockedBy(uid2, uid1);
    }

    // ── Chats & Messages ───────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated() && (
        // Direct chat branch (2 participants)
        (
          (!('type' in request.resource.data) || request.resource.data.type == 'direct')
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants[0] is string
          && request.resource.data.participants[1] is string
          && !isBlockedEitherWay(request.resource.data.participants[0], request.resource.data.participants[1])
        )
        ||
        // Group chat branch (>= 2 initial participants, creator is owner & admin)
        (
          request.resource.data.type == 'group'
          && request.resource.data.ownerId == request.auth.uid
          && request.auth.uid in request.resource.data.adminIds
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() >= 2
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
        )
      );

      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.participants
        && (
          // Direct chat branch: order-insensitive participants match
          (
            (!('type' in resource.data) || resource.data.type == 'direct')
            && resource.data.participants.size() == 2
            && resource.data.participants[0] is string
            && resource.data.participants[1] is string
            && !isBlockedEitherWay(resource.data.participants[0], resource.data.participants[1])
            && request.resource.data.participants.hasAll(resource.data.participants)
            && resource.data.participants.hasAll(request.resource.data.participants)
          )
          ||
          // Group chat branch
          (
            resource.data.type == 'group'
            && (
              // 1. Group admin can update group info, metadata and participants; only owner can modify adminIds
              (
                request.auth.uid in resource.data.adminIds
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'name', 'description', 'avatar', 'imageUrl', 'participants', 'adminIds', 'memberCount', 'updatedAt'
                ])
                && request.resource.data.ownerId == resource.data.ownerId
                && resource.data.ownerId in request.resource.data.participants
                && resource.data.ownerId in request.resource.data.adminIds
                && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds']) || request.auth.uid == resource.data.ownerId)
                && request.resource.data.participants.hasAll(request.resource.data.adminIds)
                && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100))
                && request.resource.data.participants.size() >= 1
              )
              ||
              // 2. Member leaving: only removes themselves and decrements/updates member count
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'memberCount', 'updatedAt'])
                && !(request.auth.uid in request.resource.data.participants)
                && resource.data.participants.hasAll(request.resource.data.participants)
                && request.resource.data.participants.size() == resource.data.participants.size() - 1
                && request.auth.uid != resource.data.ownerId
              )
              ||
              // 3. Any active participant sending a message can update message preview fields
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'lastMessage', 'lastMessageAt', 'lastSenderId', 'readBy', 'updatedAt'
                ])
                && request.resource.data.lastSenderId == request.auth.uid
                && request.resource.data.lastMessage is string
                && request.resource.data.lastMessage.size() <= 1000
                && request.resource.data.readBy == [request.auth.uid]
              )
              ||
              // 4. Any active participant reading messages can mark chat as read
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt'])
                && (!('readBy' in resource.data) || request.resource.data.readBy.hasAll(resource.data.readBy))
                && request.resource.data.readBy.hasAll([request.auth.uid])
                && request.resource.data.readBy.size() <= (('readBy' in resource.data) ? resource.data.readBy.size() + 1 : 1)
                && resource.data.participants.hasAll(request.resource.data.readBy)
              )
              ||
              // 5. Group owner transferring ownership to an active participant
              (
                request.auth.uid == resource.data.ownerId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt'])
                && request.resource.data.ownerId in resource.data.participants
                && request.resource.data.ownerId in request.resource.data.adminIds
                && request.resource.data.participants.hasAll(request.resource.data.adminIds)
              )
            )
          )
        );

      allow delete: if isAuthenticated() 
        && resource.data.type == 'group' 
        && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() 
          && request.resource.data.senderId == request.auth.uid 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && (
            // Direct chat: verify neither participant is blocked
            (
              (!('type' in get(/databases/$(database)/documents/chats/$(chatId)).data) || get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'direct')
              && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.size() == 2
              && !isBlockedEitherWay(
                get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0],
                get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]
              )
            )
            ||
            // Group chat: any member in participants can post
            (
              get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group'
            )
          );
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Mentions, Music, Reviews, CheckIns, Hashtags ───────
    // Mentions: public read; create requires author attribution; update/delete restricted to author
    match /mentions/{mentionId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        ('authorId' in resource.data && resource.data.authorId == request.auth.uid && (!('authorId' in request.resource.data) || request.resource.data.authorId == resource.data.authorId)) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId))
      );
      allow delete: if isAuthenticated() && (
        ('authorId' in resource.data && resource.data.authorId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
    }

    // Helper function: verifies music track ownership without conflicting identity ambiguity
    function isMusicOwner(data, authUid) {
      return (
        // Case 1: Both userId and attribution exist -> they must agree on authUid
        ('userId' in data && 'attribution' in data &&
          data.userId == authUid && data.attribution == ('Uploaded by user ' + authUid)) ||
        // Case 2: Only canonical userId exists -> must equal authUid
        ('userId' in data && !('attribution' in data) &&
          data.userId == authUid) ||
        // Case 3: Legacy document with only attribution -> must equal authUid attribution
        (!('userId' in data) && 'attribution' in data &&
          data.attribution == ('Uploaded by user ' + authUid))
      );
    }

    // Music: public read; creator can upload original sounds; creator can update/delete their own tracks
    match /music/{musicId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid &&
        (!('attribution' in request.resource.data) || request.resource.data.attribution == ('Uploaded by user ' + request.auth.uid))
      );
      allow update: if isAuthenticated()
        // Caller must be canonical owner without conflicts
        && isMusicOwner(resource.data, request.auth.uid)
        // Canonical userId cannot be changed
        && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)
        // Attribution cannot be changed
        && (!('attribution' in request.resource.data) || request.resource.data.attribution == resource.data.attribution);

      allow delete: if isAuthenticated() && isMusicOwner(resource.data, request.auth.uid);
    }

    // Venue Reviews: public read; create requires authorId attribution; update/delete restricted to review author
    match /venueReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        ('authorId' in resource.data && resource.data.authorId == request.auth.uid && (!('authorId' in request.resource.data) || request.resource.data.authorId == resource.data.authorId)) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId))
      );
      allow delete: if isAuthenticated() && (
        ('authorId' in resource.data && resource.data.authorId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
    }

    // Check-ins: public read; create requires userId attribution; update/delete restricted to check-in owner
    match /checkIns/{checkInId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Hashtags: public read; create requires creator attribution; immutable once indexed
    match /hashtags/{tagId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        ('createdBy' in request.resource.data && request.resource.data.createdBy == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid && (!('createdBy' in request.resource.data) || request.resource.data.createdBy == resource.data.createdBy)) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId))
      );
      allow delete: if isAuthenticated() && (
        ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
    }

    // ── Blocked Users ─────────────────────────────────────
    // Only the blocking user can read/write their own block list.
    // Blocked users cannot see they are blocked.
    match /blocked/{userId}/blockedUsers/{targetId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── Remote App Configuration (OTA) ────────────────────
    // Public read permits all clients (authenticated or unauthenticated)
    // to check versioning, kill-switches, and feature flags.
    // All client writes are strictly denied (fail-closed).
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── DJ Calendars (Personal Calendar with Follow-Only Privacy) ───
    function isFollowerOf(djUid) {
      return isAuthenticated() && exists(/databases/$(database)/documents/followers/$(djUid)/userFollowers/$(request.auth.uid));
    }

    match /djCalendars/{djUid} {
      // Minimum secure read:
      // 1. Owner can always read their own settings.
      // 2. Non-owner can ONLY read if the calendar is explicitly NOT private:
      //    - Public or Followers-only: authenticated users can inspect privacy tier (so UI can show follow prompt).
      //    - Private calendar: STRICTLY DENIED to all non-owners. No metadata or update timestamps leaked.
      // 3. Missing 'privacy' field defaults to 'private' (fail-closed).
      allow read: if isOwner(djUid) || (
        isAuthenticated() &&
        'privacy' in resource.data &&
        resource.data.privacy in ['followers', 'public']
      );

      // Writes (create, update, delete) are strictly restricted to the DJ calendar owner.
      allow create: if isOwner(djUid) && (!('djUid' in request.resource.data) || request.resource.data.djUid == djUid);
      allow update: if isOwner(djUid) && (!('djUid' in request.resource.data) || request.resource.data.djUid == djUid);
      allow delete: if isOwner(djUid);

      match /entries/{entryId} {
        // Writes (create, update, delete) strictly restricted to the calendar owner.
        allow create: if isOwner(djUid) && (!('djUid' in request.resource.data) || request.resource.data.djUid == djUid);
        allow update: if isOwner(djUid);
        allow delete: if isOwner(djUid);

        // Read permissions:
        // 1. Owner always has full read access (including confidential notes and private rehearsal slots).
        // 2. Non-owners are strictly DENIED if:
        //    - Unauthenticated (signed-out visitor)
        //    - Calendar is private or missing privacy field (fail-closed)
        //    - Entry is private or missing visibility field (fail-closed)
        // 3. Non-owners are ALLOWED only if:
        //    - Calendar is public AND entry visibility is public
        //    - OR Calendar is followers/public AND entry is followers/public AND requester is verified follower
        allow read: if isOwner(djUid) || (
          isAuthenticated() &&
          'visibility' in resource.data &&
          resource.data.visibility in ['followers', 'public'] &&
          'privacy' in get(/databases/$(database)/documents/djCalendars/$(djUid)).data && (
            (get(/databases/$(database)/documents/djCalendars/$(djUid)).data.privacy == 'public' &&
             resource.data.visibility == 'public') ||
            (get(/databases/$(database)/documents/djCalendars/$(djUid)).data.privacy in ['followers', 'public'] &&
             isFollowerOf(djUid))
          )
        );
      }
    }
  }
}

