rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 25 * 1024 * 1024; // 25 MB max
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
          && request.resource.size < 500 * 1024 * 1024; // 500 MB max
    }

    function isValidMedia() {
      return isValidImage() || isValidVideo() || request.resource.contentType.matches('audio/.*');
    }

    // ── Diagnostic Connection Test ─────────────────────────
    match /testConnection/{uid}/{fileName} {
      allow read, write: if isOwner(uid);
    }

    // ── User profile & cover photos ────────────────────────
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidMedia();
    }

    // ── Post media (images/videos) ────────────────────────
    match /posts/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidMedia();
    }

    // ── Reel videos ───────────────────────────────────────
    match /reels/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && (isValidVideo() || isValidImage());
    }

    // ── Story media ───────────────────────────────────────
    match /stories/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidMedia();
    }

    // ── Event banners & media ─────────────────────────────
    match /events/{uid}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidMedia();
    }

    // ── General user uploads / fallback ───────────────────
    match /uploads/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidMedia();
    }
  }
}
