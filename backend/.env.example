# Copy this file to .env and fill in real values

DEBUG=True
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_50_CHAR_STRING
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/deckknob
# Required in production for Django Channels/WebSocket notifications across workers.
# Leave blank locally to use the in-memory development fallback.
REDIS_URL=redis://localhost:6379/0

INSTAGRAM_CLIENT_ID=YOUR_INSTAGRAM_APP_ID_HERE
INSTAGRAM_CLIENT_SECRET=YOUR_INSTAGRAM_APP_SECRET_HERE
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback/
